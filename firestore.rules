rules_version = '2';
// All writes go through the API (Admin SDK bypasses these rules). Clients may only read their own checks
// and the public aggregate stats; entities, reporters, reports and usage are server-only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /checks/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }
    match /stats/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
