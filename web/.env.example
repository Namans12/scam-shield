# Firebase web config (public values; see the Firebase console > Project settings > Your apps).
# Copy to .env.local for local development. Production values live in .env.production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, dev server only: where /api is proxied to (default http://localhost:8080).
# Read from the shell environment, not from this file:  DEV_API_URL=http://localhost:8080 npm run dev -w web
